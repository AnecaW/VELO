# Copy privately to deployment/.env; never commit real values.
VELO_PUBLIC_URL=https://velo.example.com
VELO_ENCRYPTION_KEYS=REPLACE_WITH_FERNET_KEY
VELO_IMAGE=velo-backend:local
# Set 0.0.0.0 only for LAN debug or a proxy on another host. Restrict via firewall.
VELO_BIND_ADDRESS=127.0.0.1
VELO_PORT=8080
STRAVA_CLIENT_ID=
STRAVA_CLIENT_SECRET=

# Optional; blank host/from disables password recovery.
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURITY=starttls
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM=

# Optional server-only route planning credential
ORS_API_KEY=
